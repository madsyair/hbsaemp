msgstr "1 · Muat data"

#: ../../source/python/explanation/workflow-order.md
msgid "`load_dataset`, or pandas"
msgstr "`load_dataset`, atau pandas"

#: ../../source/python/explanation/workflow-order.md
msgid "input to the workflow"
msgstr "masukan bagi alur kerja"

