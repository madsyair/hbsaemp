msgid "5 · Check convergence"
msgstr "5 · Periksa konvergensi"

#: ../../source/python/explanation/workflow-order.md
msgid "`check_convergence` (`hbcc`)"
msgstr "`check_convergence` (`hbcc`)"

#: ../../source/python/explanation/workflow-order.md
msgid "validating the computation"
msgstr "validasi komputasi"

#: ../../source/python/explanation/workflow-order.md
msgid "6 · Update the model"
msgstr "6 · Perbarui model"

#: ../../source/python/explanation/workflow-order.md
