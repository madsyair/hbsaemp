#: ../../source/python/how-to/migrate-from-hbsaems.md:1
msgid "Migrate from the R package"
msgstr "Migrasi dari paket R"

#: ../../source/python/how-to/migrate-from-hbsaems.md:3
msgid "Translate an `hbsaems` script into Python, one call at a time."
msgstr "Terjemahkan skrip `hbsaems` ke Python, satu pemanggilan demi satu pemanggilan."

#: ../../source/python/how-to/migrate-from-hbsaems.md:5
msgid "Before you start"
msgstr "Sebelum memulai"

#: ../../source/python/how-to/migrate-from-hbsaems.md:7
msgid "Every R function has a Python name, and the R name is kept as an alias. An alias is the same function object, not a wrapper:"
msgstr "Setiap fungsi R memiliki nama Python, dan nama R-nya dipertahankan sebagai alias. Alias adalah objek fungsi yang sama, bukan pembungkus:"

#: ../../source/python/how-to/migrate-from-hbsaems.md:26
msgid "Do it"
msgstr "Kerjakan"

#: ../../source/python/how-to/migrate-from-hbsaems.md:20
msgid "R `hbsaems`"
msgstr "R `hbsaems`"

#: ../../source/python/how-to/migrate-from-hbsaems.md:20
msgid "Python `hbsaemp`"
msgstr "Python `hbsaemp`"

#: ../../source/python/how-to/migrate-from-hbsaems.md:20
msgid "`hbm(...)`"
msgstr "`hbm(...)`"

#: ../../source/python/how-to/migrate-from-hbsaems.md:20
msgid "`hbm(...)` or `create_model(...)`"
msgstr "`hbm(...)` atau `create_model(...)`"

